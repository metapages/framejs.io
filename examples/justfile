set shell := ["bash", "-c"]
set dotenv-load := true
# minimal formatting, bold is very useful

bold := '\033[1m'
normal := '\033[0m'
green := "\\e[32m"
yellow := "\\e[33m"
blue := "\\e[34m"
magenta := "\\e[35m"
grey := "\\e[90m"
cyan := "\\e[36m"
@_help:
    just --list --unsorted
    echo -e "    Sub-commands: (just <sub-command> <?command>)"
    echo -e "        {{ cyan }}jupyterlite{{ normal }}"

# Build the Jupyter test Docker image
_build-jupyter-docker:
    docker compose -f jupyter/docker-compose.yml build

# Run Jupyter widget unit tests in Docker (no browser needed)
test-jupyter-unit: _build-jupyter-docker
    docker compose -f jupyter/docker-compose.yml run --rm test-unit

# Run notebook execution test via nbmake in Docker (kernel only, no browser)
test-jupyter-notebook: _build-jupyter-docker
    docker compose -f jupyter/docker-compose.yml run --rm test-notebook

# Run Playwright browser integration tests in Docker (no external network required)
test-jupyter-browser: _build-jupyter-docker
    docker compose -f jupyter/docker-compose.yml run --rm test-browser

# Run all Playwright browser tests in Docker, including network-dependent ones (CDN + framejs.io)
test-jupyter-browser-network: _build-jupyter-docker
    docker compose -f jupyter/docker-compose.yml run --rm test-browser-network

# Run all Jupyter-related tests in Docker (unit + notebook + browser INCLUDING the network tier)
# The network tier is the only one that loads a real widget and checks data flows
# through it. With it excluded, a widget that rendered but never received inputs
# (framejs.app's embed wrapper not relaying the metapage protocol) passed for weeks.
test-jupyter:
    just test-jupyter-unit
    just test-jupyter-notebook
    just test-jupyter-browser-network

# Build the docs' JupyterLite demo and test it in a browser: the bundle loads, and running the demo draws data inside its widgets
test-jupyterlite:
    just jupyterlite/build
    npm --prefix ../test install
    npx --prefix ../test playwright install chromium
    cd ../test && npx playwright test --config playwright.jupyterlite.config.ts

# Pick a free host port: try the desired one, otherwise fall back to an OS-assigned free port.
_free-port desired:
    #!/usr/bin/env bash
    set -euo pipefail
    python3 -c '
    import socket, sys
    desired = int(sys.argv[1])
    def free(p):
        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
            try:
                s.bind(("", p)); return True
            except OSError:
                return False
    if free(desired):
        print(desired)
    else:
        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
            s.bind(("", 0)); print(s.getsockname()[1])
    ' "{{ desired }}"

# Run JupyterLab in Docker (editable framejs). Uses JUPYTER_PORT (default 8888), or the next free port if that one is taken. Copy the access URL from the container logs.
jupyter-docker: _build-jupyter-docker
    #!/usr/bin/env bash
    set -euo pipefail
    export JUPYTER_PORT="$(just _free-port "${JUPYTER_PORT:-8888}")"
    echo -e "{{ green }}JupyterLab → http://localhost:${JUPYTER_PORT}{{ normal }} (token in the container logs below)"
    docker compose -f jupyter/docker-compose.yml up jupyter

# Run test-jupyter, then start JupyterLab in Docker (same image as CI tests).
jupyter-docker-check: test-jupyter
    #!/usr/bin/env bash
    set -euo pipefail
    export JUPYTER_PORT="$(just _free-port "${JUPYTER_PORT:-8888}")"
    echo -e "{{ green }}JupyterLab → http://localhost:${JUPYTER_PORT}{{ normal }} (token in the container logs below)"
    docker compose -f jupyter/docker-compose.yml up jupyter

# Build the marimo test Docker image
_build-marimo-docker:
    docker compose -f marimo/docker-compose.yml build

# Run marimo widget unit tests in Docker (no browser needed)
test-marimo-unit: _build-marimo-docker
    docker compose -f marimo/docker-compose.yml run --rm test-unit

# Run Playwright browser integration tests for marimo in Docker (no external network required)
test-marimo-browser: _build-marimo-docker
    docker compose -f marimo/docker-compose.yml run --rm test-browser

# Run all Playwright browser tests for marimo in Docker, including network-dependent ones
test-marimo-browser-network: _build-marimo-docker
    docker compose -f marimo/docker-compose.yml run --rm test-browser-network

# Run all marimo-related tests in Docker (unit + browser, no external network)
test-marimo:
    just test-marimo-unit
    just test-marimo-browser

# Run marimo in Docker (editable framejs). Uses MARIMO_PORT (default 2718), or the next free port if that one is taken.
marimo-docker:
    #!/usr/bin/env bash
    set -euo pipefail
    export MARIMO_PORT="$(just _free-port "${MARIMO_PORT:-2718}")"
    echo -e "{{ green }}marimo → http://localhost:${MARIMO_PORT}{{ normal }} (open the URL printed in the logs below)"
    docker compose -f marimo/docker-compose.yml up --build

alias jupyterlite := _jupyterlite
@_jupyterlite +args="":
    just jupyterlite/{{ args }}