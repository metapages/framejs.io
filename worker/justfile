set shell          := ["bash", "-c"]
set dotenv-load    := true
export SERVER_PORT := env_var_or_default("SERVER_PORT", "3000")
export APP_FQDN    := env_var_or_default("APP_FQDN", "framejs-io.localhost")

@_help:
    just --list --unsorted

dev:
    deno run --allow-all HTTPS://deno.land/x/metapages@v0.0.17/exec/open_url.ts https://metapages.github.io/load-page-when-available/?url=http://${APP_FQDN}:${SERVER_PORT}
    DEV=true PORT={{SERVER_PORT}} APP_FQDN={{APP_FQDN}} deno run --watch -A ./server.ts
    
# Generate all raster favicons / app icons + manifest from static/favicon.svg
@generate-favicons:
    deno run --allow-read --allow-write --allow-net ./scripts/generate-favicons.ts

# Format TypeScript
@fmt:
    deno fmt .

# Quick type check (the Deno entry/app, and the Cloudflare Workers entry)
@check:
    deno check server.ts cloudflare.ts
    echo "✅ worker typescript compilation"

# Run the production (Cloudflare Workers) build locally in workerd, on :8787.
# Needs editor + docs built (`just build` at the repo root). S3 is unconfigured
# unless you pass vars, e.g. --var S3_ACCESS_KEY_ID:... --var S3_SECRET_ACCESS_KEY:...
cf-dev +args="":
    deno run -A scripts/build-cloudflare.ts
    npx -y wrangler@4 dev {{ args }}

# Read-only smoke test of a deployed worker, e.g. https://framejs-io.<account>.workers.dev
smoke base ref="https://framejs.io":
    ./scripts/smoke.sh {{ base }} {{ ref }}

# Type check plus unit tests
test: check
    deno test --allow-all src/
    echo "✅ worker unit tests"