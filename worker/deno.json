{
  "minimumDependencyAge": "0",
  "deploy": {
    "org": "metapage",
    "app": "metaframe-js"
  },
  "tasks": {
    "dev": "deno run --watch main.ts"
  },
  "fmt": {
    "exclude": ["docs/"]
  },
  "imports": {
    "@hono/hono": "jsr:@hono/hono@^4",
    "@resvg/resvg-wasm": "npm:@resvg/resvg-wasm@^2.6.2",
    "@aws-sdk/s3-request-presigner": "npm:@aws-sdk/s3-request-presigner@^3.997.0",
    "qrcode": "npm:qrcode@1.5.4",
    "uuidv7": "npm:uuidv7@^1.0.2",
    "acorn": "npm:acorn@^8.15.0",
    "acorn-walk": "npm:acorn-walk@^8.3.4",
    "@std/assert": "jsr:@std/assert@1",
    "@std/encoding": "jsr:@std/encoding@1",
    "@metapages/metapage": "npm:@metapages/metapage@^1.10.15",
    "@metapages/hash-query": "https://esm.sh/@metapages/hash-query@0.9.12"
  }
}
